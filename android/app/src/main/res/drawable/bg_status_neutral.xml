<?xml version="1.0" encoding="utf-8"?>
<!--
    Waiting or advisory: a white card with a structured border, per the Heritage
    brief. Only the two outcome states (accepted, rejected) flood with colour,
    which is what makes them read instantly.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/surface_card" />
    <stroke android:width="1dp" android:color="@color/hairline" />
    <corners android:radius="8dp" />
</shape>

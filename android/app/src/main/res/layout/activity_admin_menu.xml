<?xml version="1.0" encoding="utf-8"?>
<!--
    Admin landing screen. Five destinations as large tiles rather than a list:
    this is used standing up, often one-handed, on a small handheld.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:fillViewport="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_page"
    android:padding="16dp">

    <!--
        fillViewport + match_parent + weighted rows: the tiles expand to fill a
        screen that has room, and the ScrollView still saves them on a shorter
        one. Fixed 120dp heights left a third of this screen empty, which is the
        same complaint that was made about the clock-in page.
    -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <TextView
            android:id="@+id/menuLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:textColor="@color/text_muted"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="2"
            android:orientation="horizontal">

            <Button
                android:id="@+id/tileEnrol"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:backgroundTint="@color/tile_enrol"
                android:text="@string/menu_enrol"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/tileStaff"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:backgroundTint="@color/tile_staff"
                android:text="@string/menu_staff"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_weight="2"
            android:orientation="horizontal">

            <Button
                android:id="@+id/tileRecords"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:backgroundTint="@color/tile_records"
                android:text="@string/menu_records"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/tileLocation"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:backgroundTint="@color/tile_location"
                android:text="@string/menu_location"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <Button
            android:id="@+id/tileDepartments"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_weight="1"
            android:backgroundTint="@color/tile_departments"
            android:text="@string/menu_departments"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/tileSettings"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_weight="1"
            android:backgroundTint="@color/tile_settings"
            android:text="@string/menu_settings"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/menuWarning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="@color/state_pending"
            android:textSize="14sp" />
    </LinearLayout>
</ScrollView>

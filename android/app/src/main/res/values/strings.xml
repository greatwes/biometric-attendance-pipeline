    <!-- Punch types. The wording on the button is what staff will call it.
         These are labels over the ADMS state codes, never the codes themselves:
         check_in is code 3 (Break-In, returning) and check_out is code 2
         (Break-Out, leaving temporarily), and renaming them here changes not one
         thing about what the device puts on the wire. The matching names in
         Snowflake live in PUNCH_TYPES. -->
    <string name="clock_in">Clock In</string>
    <string name="clock_out">Clock Out</string>
    <string name="check_in">Back on Seat</string>
    <string name="check_out">Stepping Out</string>
    <string name="choose_action">Choose an option</string>
    <string name="choose_action_hint">Tap Clock In, Clock Out, Stepping Out or Back on Seat</string>
    <string name="place_finger_for">%1$s</string>
    <string name="already_recorded_action">%1$s already recorded for %2$s</string>

    <!-- What a person sees after a successful punch. Two parts because the
         status card has a large title and a smaller detail line; together they
         read as one message. -->
    <!-- The time is no longer part of these sentences: it is its own view, so
         it can be set much larger and hidden for messages that have no time. -->
    <string name="msg_clock_in_title">Welcome\n%1$s</string>
    <string name="msg_clock_in_detail">You Clocked in at</string>
    <string name="msg_clock_out_title">Thank You\n%1$s</string>
    <string name="msg_clock_out_detail">for Contributing to the team today\nYou Clocked Out at</string>
    <string name="msg_stepping_out_title">See you shortly\n%1$s</string>
    <string name="msg_stepping_out_detail">You are Stepping Out at</string>
    <string name="msg_back_on_seat_title">Welcome Back\n%1$s</string>
